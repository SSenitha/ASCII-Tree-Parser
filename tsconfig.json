{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",

    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  
  "include": [
    "src/**/*",
    "examples/**/*",
    "tests/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}